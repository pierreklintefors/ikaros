<group name="BehaviorSelectorCooldownsTest"
       description="Each behaviour has its own cooldown: with cooldown 10, 0.3 the first behaviour starts only on the first of three requests 0.4 s apart, the second on all three"
       start="true" stop="14" tick_duration="0.1" threads="1"
       cli_args="-u${TEST_DIR}"
       expected_output_contains="tick = {2}&#10;trigger = {1, 1}||tick = {6}&#10;trigger = {0, 1}||tick = {10}&#10;trigger = {0, 1}"
       expected_output_once="trigger = {1, 1}">
    <module class="InputFile" name="Script" filename="fixture_BehaviorSelector_cooldowns.jsonl" send_end_of_file="false" />
    <module class="Constant" name="Idle" data="0" />
    <module class="BehaviorSelector" name="Behaviors" count="2" idle_weights="0, 0" cooldown="10, 0.3" min_interval="100" max_interval="100" seed="1" />
    <module class="Print" name="Tick" />
    <module class="Print" name="Trigger" />

    <connection source="Idle.OUTPUT" target="Behaviors.ENGAGED" delay="0" />
    <connection source="Script.REQ" target="Behaviors.REQUEST" delay="0" />
    <connection source="Script.TICK" target="Tick.INPUT" delay="0" label="tick" />
    <connection source="Behaviors.TRIGGER" target="Trigger.INPUT" delay="0" label="trigger" />
</group>
