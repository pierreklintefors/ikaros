<class name="Delta" description="Learning using the delta rule">

	<description type="text">
		Simple conditioning model. Acquisition only, unless extinction is above 0. Learning using the delta rule with a linear output function. By default the weights change on every tick; with trials set, they change once per US onset and once per CS presentation, so the number of pairings rather than their duration sets what is learned.
	</description>

	<parameter name="alpha" type="number" default="0.1" description="learning rate" />
	<parameter name="extinction" type="number" default="0" min="0" description="learning rate when CR exceeds US, so a CS that is no longer followed by the US loses its response; 0 keeps acquisition only" />
	<parameter name="trials" type="bool" default="no" description="Learn once per event instead of on every tick: each US onset during a CS presentation moves the response alpha of the way to the US, and each CS presentation that ends without a US moves it extinction of the way to 0" />
	<parameter name="gap" type="number" default="0.5" min="0" description="With trials, seconds the CS or the US must be absent before it counts as ended; a shorter absence, such as a missed detection, continues it" />
	<parameter name="inverse" type="bool" default="no" description="Set CR to max(0, CR-US) to imitate cerebellar inhibition." />

	<input name="CS" description="The conditioned stimulus input" optional="yes" />
	<input name="US" description="The unconditioned stimulus input" optional="yes" />
	<state name="WEIGHTS" type="matrix" size="CS.size" persistent="true" />
	<output name="CR" description="The conditioned response; with trials, it is held through gaps in the CS" size="1"/>

</class>
