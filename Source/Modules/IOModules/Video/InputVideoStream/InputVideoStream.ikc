<class name="InputVideoStream">
    <description>Grabs video using FFmpeg, optionally crops the decoded source frame, resizes it, and outputs RGB/intensity images.</description>

    <parameter name="size_x" type="int" default="640" />
    <parameter name="size_y" type="int" default="480" />

    <!-- Crop rectangle in SOURCE-FRAME pixels. A width/height of 0 means
         use the full remaining source dimension. -->
    <parameter name="crop_x" type="number" default="0"
           description="Horizontal crop offset in source-frame pixels, measured from the left edge." />

    <parameter name="crop_y" type="number" default="0"
            description="Vertical crop offset in source-frame pixels, measured from the top edge." />

    <parameter name="crop_width" type="number" default="0"
            description="Width of crop region in source-frame pixels. Set to 0 to use the available source width." />

    <parameter name="crop_height" type="number" default="0"
            description="Height of crop region in source-frame pixels. Set to 0 to use the available source height." />

    <parameter name="url" type="string" default="" />
    <parameter name="info" type="bool" default="false" />
    <parameter name="synchronized_framegrabber" type="bool" default="false" />
    <parameter name="synchronized_tick" type="bool" default="true" />
    <parameter name="uv4l" type="bool" default="false" />

    <output name="RED" description="The red channel." alias="OUTPUT[0]"/>
	<output name="GREEN" description="The green channel." alias="OUTPUT[1]"/>
	<output name="BLUE" description="The blue channel." alias="OUTPUT[2]"/>

	<output name="INTENSITY" description="The intensity channel." size="@size_y,@size_x"/>
	<output name="OUTPUT" description="RGB image." size="3,@size_y,@size_x"/>
</class>
