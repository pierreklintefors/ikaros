<group name="GazeLockTiltScaleTest"
       description="tilt_speed_scale and tilt_acceleration_scale make the tilt move more gently while pan keeps the head limits"
       start="true" stop="14" tick_duration="0.1"
       expected_output_contains="head = {0.5, 1}||head = {1.5, 3}||head = {5, 10}||head = {10.5, 17}||head = {15.6847, 20}||head = {20, 20}"
       expected_output_not_contains="head = {20.||head = {21">
    <module class="Constant" name="Follow" data="0" />
    <module class="Constant" name="Manual" data="20, 20" />
    <module class="GazeLock" name="Gaze" head_max_speed="100" head_max_acceleration="100" tilt_speed_scale="0.5" tilt_acceleration_scale="0.5" />
    <module class="Print" name="Head" />

    <connection source="Follow.OUTPUT" target="Gaze.FOLLOW" delay="0" />
    <connection source="Manual.OUTPUT" target="Gaze.MANUAL_HEAD" delay="0" />
    <connection source="Gaze.GOAL_POSITION" target="Gaze.PRESENT_POSITION" delay="1" />
    <connection source="Gaze.HEAD_GOAL" target="Head.INPUT" delay="0" label="head" />
</group>
