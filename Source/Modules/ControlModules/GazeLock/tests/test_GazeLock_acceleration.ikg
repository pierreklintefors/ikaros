<group name="GazeLockAccelerationTest"
       description="The head goal accelerates and brakes within head_max_acceleration and stops on the manual goal without overshoot"
       start="true" stop="10" tick_duration="0.1"
       expected_output_contains="head = {0, 1}||head = {0, 3}||head = {0, 6}||head = {0, 10}||head = {0, 14}||head = {0, 17}||head = {0, 19}||head = {0, 20}"
       expected_output_not_contains="head = {0, 20.||head = {0, 21||head = {0, 19.9">
    <module class="Constant" name="Follow" data="0" />
    <module class="Constant" name="Manual" data="0, 20" />
    <module class="GazeLock" name="Gaze" head_max_speed="100" head_max_acceleration="100" />
    <module class="Print" name="Head" />

    <connection source="Follow.OUTPUT" target="Gaze.FOLLOW" delay="0" />
    <connection source="Manual.OUTPUT" target="Gaze.MANUAL_HEAD" delay="0" />
    <connection source="Gaze.GOAL_POSITION" target="Gaze.PRESENT_POSITION" delay="1" />
    <connection source="Gaze.HEAD_GOAL" target="Head.INPUT" delay="0" label="head" />
</group>
