<group name="HeadMirrorDeadZoneTest"
       description="With tilt_dead_zone small pitch changes do not move the tilt goal, a larger change is followed to its end, and after settle_time small changes are ignored again"
       start="true" stop="11" tick_duration="0.1"
       cli_args="-u${TEST_DIR}"
       expected_output_contains="head = {0, 0}||head = {-4, 0}||head = {-5, 0}"
       expected_output_not_contains="head = {-1.5, 0}||head = {1.5, 0}||head = {-5.5, 0}||head = {-4.5, 0}">
    <module class="InputFile" name="Script" filename="fixture_HeadMirror_deadzone.jsonl" send_end_of_file="false" />
    <module class="HeadMirror" name="Mirror" engage_time="0" pose_smoothing="0" fade_in="0" tilt_dead_zone="2" settle_time="0.2" />
    <module class="Print" name="Head" />

    <connection source="Script.POSE" target="Mirror.POSE" delay="0" />
    <connection source="Script.VALID" target="Mirror.VALID" delay="0" />
    <connection source="Script.TARGET" target="Mirror.TARGET" delay="0" />
    <connection source="Script.DIRECTION" target="Mirror.DIRECTION" delay="0" />

    <connection source="Mirror.HEAD_GOAL" target="Head.INPUT" delay="0" label="head" />
</group>
