<group name="AveragePoolChannelsTest"
       description="3 x 3 windows with stride 2 on a two-channel 3 x 5 image, channel by channel: the two windows share the middle column"
       start="true" stop="1"
       expected_output_contains="{0.666667, 3}||{1.33333, 7}">
    <module class="Constant" name="Image" data="[[[1, 1, 0, 0, 9], [1, 1, 0, 0, 9], [1, 1, 0, 0, 9]], [[0, 0, 4, 8, 9], [0, 0, 4, 8, 9], [0, 0, 4, 8, 9]]]" />
    <module class="AveragePool" name="Pool" size="3" stride="2" />
    <module class="Print" name="Print" />

    <connection source="Image.OUTPUT" target="Pool.INPUT" delay="0" />
    <connection source="Pool.OUTPUT" target="Print.INPUT" delay="0" label="pooled" />
</group>
