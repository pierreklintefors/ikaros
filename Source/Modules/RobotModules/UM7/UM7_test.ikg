<group name="Example">
   <module _x="1272" _y="168" class="UM7" description="connect to a UM7 orientation sensor via USB" name="UM7" port="/dev/cu.usbserial-AU04OIL4"/>
   <widget _index_="0" _x="48" _y="48" x="48" y="48" buffer_size="50" class="plot" stroke_color="blue, green, red" orientation="vertical" height="313" y_max="100" y_min="0" name="Gyroplot" show_frame="no" show_title="yes" source="UM7.ProcessedGyro" title="Gyro" width="385"/>
   <widget _index_="1" _x="432" _y="48" x="432" y="48" buffer_size="50" class="plot" stroke_color="blue, green, red" orientation="vertical" height="313" y_max="1" y_min="-1" name="Accelplot" show_frame="no" show_title="yes" source="UM7.ProcessedAccel" title="Accelerometer" width="385"/>
   <widget _index_="2" _x="48" _y="432" x="48" y="432" buffer_size="80" class="plot" stroke_color="blue, green, red" orientation="vertical" height="337" y_max="80" y_min="0" name="Eulerplot" show_frame="no" show_title="yes" source="UM7.EulerAngles" title="Euler" width="745"/>
</group>
