<class name="AppleVisionHandDetector" description="Finds hands with Apple's Vision framework and gives the index fingertip of the most prominent hand as a target, with an open-palm score">
    <description type="text">
        AppleVisionHandDetector finds hands and their finger joints with Apple's Vision framework. Of the hands
        found, it chooses the largest and gives one point of it, the index fingertip or the middle of the palm, as
        TARGET, in the same form as FaceTargetSelector.TARGET, so the hand can be followed with GazeLock or its
        distance measured with StereoDistance. OPEN tells how many of the four fingers are stretched out, so an
        open palm gives 1 and a fist 0. POINTING is 1 when only the index finger is stretched out.
    </description>

    <parameter name="point" type="number" options="index_tip,palm" default="index_tip" description="Point given as TARGET: the index fingertip, or the middle of the palm" />
    <parameter name="max_hands" type="number" default="2" min="1" description="Largest number of hands Vision looks for" />
    <parameter name="min_confidence" type="number" default="0.3" min="0" max="1" description="Joints with lower confidence are not used" />
    <parameter name="extension_ratio" type="number" default="1.15" min="1" description="A finger counts as stretched out when its tip is this many times farther from the wrist than its middle joint" />
    <parameter name="hold_time" type="number" default="0.2" min="0" description="Seconds the last hand is kept when it is briefly not found" />
    <parameter name="downsample" type="number" default="0" min="0" description="Number of 2x downsample passes before detection" />
    <parameter name="interval" type="number" default="1" min="1" description="Ticks between detections; the last result is kept in between. Hand detection is costly, so 2 or 3 saves time when the hand need not be tracked on every frame" />

    <input name="INPUT" description="Grayscale image, or RGB image with shape 3,height,width" />
    <input name="ENABLE" size="1" optional="yes" description="0 stops detection and clears the outputs, for example to look for hands only during a game; detection runs when not connected" />

    <output name="TARGET" size="3" description="x, y of the chosen point and the hand width, in centered image coordinates from -1 to 1 with y downward; zero when no hand is found" />
    <output name="VALID" size="1" description="1 while a hand is found or held" />
    <output name="OPEN" size="1" description="Fraction of the four fingers that are stretched out: 1 for an open palm, 0 for a fist" />
    <output name="POINTING" size="1" description="1 when the index finger is stretched out and the other three fingers are not" />
    <output name="COUNT" size="1" description="Number of hands found in this image" />
</class>
