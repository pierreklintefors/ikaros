<group name="FaceTargetSelectorSmoothingTest"
       description="TARGET smoothing uses the per-second rate independently of tick_duration and snaps on a new face"
       start="true" stop="3" tick_duration="0.1"
       cli_args="-u${TEST_DIR}"
       expected_output_once="target = {0.5, 0, 0.25}||target = {0.375, 0, 0.25}||target = {0.3125, 0, 0.25}">
    <module class="InputFile" name="Faces" filename="fixture_FaceTargetSelector_smoothing.jsonl" send_end_of_file="false" />
    <module class="FaceTargetSelector" name="Selector" match_distance="0.5" smoothing="6.931471805599453" />
    <module class="Print" name="Target" />

    <connection source="Faces.BOXES" target="Selector.BOXES" delay="0" />
    <connection source="Selector.TARGET" target="Target.INPUT" delay="0" label="target" />
</group>
