<group name="FaceTargetSelectorDelayTest"
       description="With switch_delay a briefly larger face does not take over; one that stays larger takes over after the delay and NEW_TARGET pulses for both selections"
       start="true" stop="12" tick_duration="0.05"
       cli_args="-u${TEST_DIR}"
       expected_output_twice="new = {1}"
       expected_output_contains="target = {-0.5, 0, 0.25}||target = {0.625, 0, 0.5}"
       expected_output_not_contains="target = {0.5, 0, 0.5}||target = {0.59375, 0, 0.5}">
    <module class="InputFile" name="Faces" filename="fixture_FaceTargetSelector_delay.jsonl" send_end_of_file="false" />
    <module class="FaceTargetSelector" name="Selector" switch_ratio="1.3" switch_delay="0.12" ignore_repeated="false" />
    <module class="Print" name="Target" />
    <module class="Print" name="New" />

    <connection source="Faces.BOXES" target="Selector.BOXES" delay="0" />
    <connection source="Selector.TARGET" target="Target.INPUT" delay="0" label="target" />
    <connection source="Selector.NEW_TARGET" target="New.INPUT" delay="0" label="new" />
</group>
