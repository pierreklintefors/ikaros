<class name="FaceTargetSelector" description="Selects one stable target face from detector boxes">
    <description type="text">
        FaceTargetSelector reads the face boxes produced by AppleVisionFaceDetector or DlibFaceDetector and
        follows one face over time. A new face is chosen by size (closest person) or by distance to the
        image center. The selected face is tracked by matching its position from tick to tick, so the
        detector's row order does not matter. Another face takes over only when it is clearly better
        (switch_ratio) or when the tracked face has been missing for longer than hold_time.
    </description>

    <parameter name="selection" type="number" default="largest" options="largest,center" description="How a new target is chosen: the largest face (closest person) or the face nearest the image center" />
    <parameter name="min_width" type="number" default="0.08" min="0" description="Ignore faces narrower than this, in centered image coordinates where the full image width is 2" />
    <parameter name="min_confidence" type="number" default="0.5" min="0" max="1" description="Ignore faces with a lower detector confidence" />
    <parameter name="match_distance" type="number" default="0.25" min="0" description="Maximum change in face center between ticks for a face to count as the tracked face" />
    <parameter name="switch_ratio" type="number" default="1.3" min="1" description="Another face replaces the tracked face only when its selection score is this many times higher" />
    <parameter name="hold_time" type="number" default="0.5" min="0" description="Seconds the tracked face may be missing before another face can be selected" />
    <parameter name="smoothing" type="rate" default="0" min="0" description="Exponential smoothing rate for TARGET in 1/s; 0 disables smoothing" />

    <input name="BOXES" description="Face box rows: x, y, width, height, confidence in centered image coordinates" />

    <output name="TARGET" size="3" description="Selected face center_x, center_y, width; held during hold_time and zero when no face is tracked" />
    <output name="VALID" size="1" description="1 on ticks where the tracked face was detected, otherwise 0" />
    <output name="TARGET_BOX" dynamic="yes" capacity="1,5" description="Selected face box row: x, y, width, height, confidence; empty when VALID is 0" />
    <output name="COUNT" size="1" description="Number of faces that passed the width and confidence filters" />
</class>
