    <widget class="table" name="HoldTable" title="Near (head holds above 0.3)" source="Near.NEAR" decimals="2" colorize="no"
            x="1276" y="1184" _x="1276" _y="1184" width="236" height="56" show_title="yes" show_frame="yes" />
    <widget class="table" name="FingerTable" title="Finger close (eyes cross at 1)" source="FingerNear.NEAR" decimals="2" colorize="no"
            x="1032" y="1248" _x="1032" _y="1248" width="236" height="56" show_title="yes" show_frame="yes" />
    <widget class="table" name="CornTable" title="Corn seen (both in one patch)" source="CornSeen.OUTPUT" decimals="0" colorize="no"
            x="1276" y="1248" _x="1276" _y="1248" width="236" height="56" show_title="yes" show_frame="yes" />
    <widget class="table" name="YellowTable" title="Corn yellow in view" source="YellowFraction.OUTPUT" decimals="4" colorize="no"
