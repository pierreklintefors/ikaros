    <connection source="LightShow.MOUTH_LOW" target="LEDs.MOUTH_LOW" delay="1" />

    <!-- Dashboard: controls and state -->

    <!-- Brain inputs -->
    <connection source="Eye.INTENSITY" target="Brain.Brightness.INPUT" delay="0" />
    <connection source="Eye.INTENSITY" target="Brain.GlarePixels.INPUT" delay="0" />
    <connection source="Arousal.AROUSAL" target="Brain.LCDrive.INPUT1" delay="0" />
