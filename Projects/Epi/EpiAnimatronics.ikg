    <connection source="CornSpotShare.OUTPUT" target="CornSeen.INPUT" delay="0" />
    <connection source="CornSeen.OUTPUT" target="Brain.Amygdala.CS" delay="1" />

    <!-- Finger close up -->
    <connection source="Eye.OUTPUT" target="Hands.INPUT" delay="1" />
    <connection source="Hands.TARGET" target="FingerNear.TARGET" delay="1" />
    <connection source="Hands.VALID" target="FingerNear.VALID" delay="1" />
