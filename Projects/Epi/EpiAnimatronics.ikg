            x="1772" y="288" _x="1772" _y="288" width="140" height="48" show_title="yes" show_frame="yes" />

    <!-- Dashboard: camera with all faces (green) and the followed face (magenta) -->
    <widget class="text" name="CameraCaption" text="Eye camera"
            x="1032" y="352" _x="1032" _y="352" width="480" height="24" show_title="no" show_frame="no" />
    <widget class="image" name="CameraImage" source="Eye.OUTPUT" format="rgb" scale="both"
            x="1032" y="376" _x="1032" _y="376" width="480" height="360" show_title="no" show_frame="no" />
    <widget class="target-boxes" name="FaceBoxes" source="Faces.BOXES" box_color="#00ff66" line_width="2" show_score="no"
            x="1032" y="376" _x="1032" _y="376" width="480" height="360" show_title="no" show_frame="no" />
    <widget class="target-boxes" name="TargetBox" source="Target.TARGET_BOX" box_color="#ff00cc" line_width="4" show_score="no"
            x="1032" y="376" _x="1032" _y="376" width="480" height="360" show_title="no" show_frame="no" />

    <!-- Dashboard: robot -->
    <widget class="epi-head" name="Head" title="Expression and gaze" epi_name="EpiGray"
            eye_direction_source="Gaze.EYE_GOAL" pupil_size_source="Expression.PUPIL_SIZE" head_position_source="Gaze.HEAD_GOAL"
            left_eye_color_source="LightShow.VIEW_LEFT_EYE" right_eye_color_source="LightShow.VIEW_RIGHT_EYE"
            top_mouth_color_source="LightShow.VIEW_MOUTH_HIGH" lower_mouth_color_source="LightShow.VIEW_MOUTH_LOW"
            x="1528" y="352" _x="1528" _y="352" width="384" height="384" show_title="yes" show_frame="yes" />

    <!-- Dashboard: motion -->
    <widget class="plot" name="EyePlot" title="Eye goal (left, right)" source="Gaze.EYE_GOAL"
            buffer_size="200" auto_range="no" y_min="-20" y_max="20" include_zero="yes"
            x="1032" y="752" _x="1032" _y="752" width="480" height="128" show_title="yes" show_frame="yes" />
    <widget class="plot" name="HeadPlot" title="Head goal (tilt, pan)" source="Gaze.HEAD_GOAL"
            buffer_size="200" auto_range="no" y_min="-45" y_max="45" include_zero="yes"
            x="1528" y="752" _x="1528" _y="752" width="384" height="128" show_title="yes" show_frame="yes" />
    <widget class="plot" name="PupilPlot" title="Pupil goal in mm (left, right)" source="Expression.PUPIL_SIZE"
            buffer_size="200" auto_range="no" y_min="4" y_max="17" include_zero="no"
            x="1032" y="896" _x="1032" _y="896" width="480" height="128" show_title="yes" show_frame="yes" />
    <widget class="plot" name="ArousalPlot" title="Arousal" source="Arousal.AROUSAL"
            buffer_size="200" auto_range="no" y_min="0" y_max="1" include_zero="yes"
            x="1528" y="896" _x="1528" _y="896" width="384" height="128" show_title="yes" show_frame="yes" />

    <!-- Dashboard: distance of the face and the left eye camera -->
    <widget class="plot" name="DistancePlot" title="Face distance in m (0 when not seen)" source="Near.DISTANCE"
            buffer_size="200" auto_range="no" y_min="0" y_max="2" include_zero="yes"
