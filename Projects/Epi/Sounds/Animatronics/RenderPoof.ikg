<group name="RenderPoof"
       title="Render the pooof sound"
       description="Renders poof.wav with the Ikaros synthesizer: a soft breath of filtered noise whose brightness and loudness fall together over a low thump, in a small room. Run with -b and -u set to this folder."
       sample_rate="24000"
       tick_duration="0.01"
       stop="140"
       start="true"
       real_time="false">

    <!-- Timing: a one-tick start, and a master gate that fades the end of the file -->
    <module class="TimeSeries" name="Start" data="1, 1; 1, 0" first_column_duration="true" base_duration="0.01" _x="24" _y="24" />
    <module class="TimeSeries" name="Gate" data="110, 1; 1, 0" first_column_duration="true" base_duration="0.01" _x="24" _y="480" />

    <!-- Breath: white noise through a low-pass filter that closes as the envelope falls. The squared
         envelope falls smoothly, like a natural decay, instead of stopping at a corner. -->
    <module class="AudioOscillator" name="Silence" volume="0" _x="24" _y="120" />
    <module class="Noise" name="White" type="gaussian" mean="0" stddev="0.56" seed="7" _x="216" _y="120" />
    <module class="ADSREnvelope" name="BreathEnvelope" attack="0.06" decay="1.1" sustain="0" release="0.05" _x="216" _y="24" />
    <module class="Multiply" name="BreathCurve" _x="408" _y="24" />
    <module class="AudioFilter" name="Breath" cutoff="200" envelope_amount="4" resonance="0.1" _x="408" _y="120" />
    <module class="Multiply" name="BreathLevel" _x="600" _y="120" />

    <!-- Thump: a low sine with a quick, smooth decay -->
    <module class="AudioOscillator" name="Low" wave_shape="sine" frequency="70" volume="0.5" _x="24" _y="264" />
    <module class="ADSREnvelope" name="ThumpEnvelope" attack="0.008" decay="0.3" sustain="0" release="0.02" _x="216" _y="336" />
    <module class="Multiply" name="ThumpCurve" _x="408" _y="336" />
    <module class="Multiply" name="Thump" _x="600" _y="264" />

    <!-- Mix, room, and the final fade -->
    <module class="Add" name="Mix" _x="792" _y="192" />
    <module class="AudioReverb" name="Room" mix="0.22" decay="0.7" damping="0.5" pre_delay="0.015" _x="984" _y="192" />
    <module class="ADSREnvelope" name="MasterEnvelope" attack="0" decay="0" sustain="1" release="0.25" _x="216" _y="480" />
    <module class="Multiply" name="Master" _x="1176" _y="192" />
    <module class="OutputAudioFile" name="File" filename="poof.wav" bits_per_sample="16" _x="1368" _y="192" />

    <connection source="Start.OUTPUT" target="BreathEnvelope.TRIG" />
    <connection source="Start.OUTPUT" target="ThumpEnvelope.TRIG" />
    <connection source="Gate.OUTPUT" target="MasterEnvelope.GATE" />

    <connection source="Silence.OUTPUT" target="White.INPUT" />
    <connection source="White.OUTPUT" target="Breath.INPUT" />
    <connection source="BreathEnvelope.OUTPUT" target="Breath.CUTOFF_MOD" />
    <connection source="BreathEnvelope.OUTPUT" target="BreathCurve.INPUT1" />
    <connection source="BreathEnvelope.OUTPUT" target="BreathCurve.INPUT2" />
    <connection source="Breath.OUTPUT" target="BreathLevel.INPUT1" />
    <connection source="BreathCurve.OUTPUT" target="BreathLevel.INPUT2" />

    <connection source="ThumpEnvelope.OUTPUT" target="ThumpCurve.INPUT1" />
    <connection source="ThumpEnvelope.OUTPUT" target="ThumpCurve.INPUT2" />
    <connection source="Low.OUTPUT" target="Thump.INPUT1" />
    <connection source="ThumpCurve.OUTPUT" target="Thump.INPUT2" />

    <connection source="BreathLevel.OUTPUT" target="Mix.INPUT1" />
    <connection source="Thump.OUTPUT" target="Mix.INPUT2" />
    <connection source="Mix.OUTPUT" target="Room.INPUT" />
    <connection source="Room.OUTPUT" target="Master.INPUT1" />
    <connection source="MasterEnvelope.OUTPUT" target="Master.INPUT2" />
    <connection source="Master.OUTPUT" target="File.INPUT" />
</group>
